# Copy to .env and adjust. keeperd reads these directly; no config file.

# Used by docker-compose.yml to initialize the Postgres container.
# Keep these in sync with the credentials embedded in DATABASE_URL below.
POSTGRES_USER=keeper
POSTGRES_PASSWORD=keeper
POSTGRES_DB=keeper

# Used by keeperd to connect. Must match the Postgres values above.
DATABASE_URL=postgres://keeper:keeper@localhost:5432/keeper

KEEPER_RPC_URL=https://api.devnet.solana.com
# KEEPER_RPC_COMMITMENT=confirmed
